{
  "expo": {
    "name": "CheapQuickVegan",
    "slug": "cheapquickvegan",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cheapquickvegan.app"
    },
    "android": {
      "package": "com.cheapquickvegan.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow CheapQuickVegan to hear voice commands like \"next step\" while you cook.",
          "speechRecognitionPermission": "Allow CheapQuickVegan to understand voice commands while you cook.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ]
  }
}
